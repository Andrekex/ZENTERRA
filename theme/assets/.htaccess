# Browser caching for the theme's static files (Apache / LiteSpeed).
# CSS, JS and the logo carry ?ver=<theme version>, and font files never change, so they can be
# cached for a year. Icons and preview images keep their filenames across updates: one week.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^logo\.svg$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico|webmanifest)$|^(favicon|zenterra-mark)\.svg$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
